# Plantilla de entorno para el despliegue del Orchestrator en VPS (deploy/vps.env)
# Copiar a /opt/incubia/staging/.env o /opt/incubia/prod/.env en el servidor.
# Permisos requeridos en el host: chmod 600 .env (propiedad de deploy:incubia-ops).

COMPOSE_PROJECT_NAME=incubia-orchestrator-staging
CONTAINER_NAME=orchestrator-staging
INCUBIA_IMAGE=incubia-orchestrator:latest

# Token Bearer de servidor a servidor (mínimo 32 caracteres)
# Generar con: openssl rand -hex 32
INCUBIA_ORCHESTRATOR_TOKEN=REPLACE_WITH_RANDOM_32_PLUS_HEX_SECRET

# Neon Ledger & Audit: Endpoint pooled (-pooler), TLS sslmode=require, rol incubia_runtime (NOBYPASSRLS)
DATABASE_URL=postgresql://incubia_runtime:REPLACE_PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Migrator: Conexión directa (sin -pooler), rol incubia_migrator
INCUBIA_MIGRATION_DATABASE_URL=postgresql://incubia_migrator:REPLACE_PASSWORD@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Identidad de deployment
INCUBIA_DEPLOYMENT_ID=incubia-staging

# Modo de ejecución (0 = LLM OpenAI real; 1 = FakeLLM determinista)
INCUBIA_FAKE_MODE=0
OPENAI_API_KEY=REPLACE_ME_WITH_OPENAI_API_KEY
INCUBIA_MODEL=gpt-4o-mini

# Knowledge Base opcional para POST /v1/knowledge/documents y RAG en POST /v1/turns (ADR-ORCH-010)
# Endpoints pooled (-pooler), TLS sslmode=require, roles separados incubia_kb_runtime / incubia_kb_ingestor
# INCUBIA_KNOWLEDGE_DEPLOYMENT_ID=incubia-staging
# INCUBIA_KNOWLEDGE_RUNTIME_DATABASE_URL=postgresql://incubia_kb_runtime:REPLACE_PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/knowledge_db?sslmode=require
# INCUBIA_KNOWLEDGE_INGEST_DATABASE_URL=postgresql://incubia_kb_ingestor:REPLACE_PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/knowledge_db?sslmode=require
# INCUBIA_KNOWLEDGE_EMBEDDING_BUDGET_FILE=/data/knowledge-embedding-budget.sqlite
