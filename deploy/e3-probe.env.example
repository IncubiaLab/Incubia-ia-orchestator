# Synthetic local real-provider probe. Copy to deploy/e3-probe.env (gitignored).
# Keep the server on 127.0.0.1. Use a dedicated runtime Knowledge DSN.
INCUBIA_E3_PROBE_REAL=1
INCUBIA_E3_PROBE_BRANCH=e3-h1-synthetic
INCUBIA_E3_PROBE_DEPLOYMENT_ID=synthetic-alpha
INCUBIA_E3_PROBE_TENANT_ID=synthetic-tenant
INCUBIA_E3_PROBE_ACTOR_ID=synthetic-actor
INCUBIA_E3_PROBE_TOKEN=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET
INCUBIA_E3_PROBE_KNOWLEDGE_DSN=postgresql://runtime:REPLACE_ME@ep-example-pooler.us-east-2.aws.neon.tech/knowledge_alpha?sslmode=require
OPENAI_API_KEY=REPLACE_ME
INCUBIA_E3_PROBE_BUDGET_FILE=/tmp/incubia-e3-probe-budget.sqlite
INCUBIA_E3_PROBE_MAX_CALLS=20
INCUBIA_E3_PROBE_MAX_INPUT_TOKENS=20000
INCUBIA_E3_PROBE_USD_CAP=0.01
INCUBIA_E3_PROBE_AUDIT_FILE=/tmp/incubia-e3-probe-audit.sqlite
