# Plantilla de configuración local. Copiar a .env (ignorado por Git) y reemplazar los valores REPLACE_*.
# Nunca subir .env, deploy/*.env ni DSN reales. Host Neon: siempre *.neon.tech con sslmode=require.
# Conexión pooled (-pooler) para runtime; directa (sin -pooler) para migraciones y backup.

# =====================================================================
# 1. Núcleo: LLM y CLI
# =====================================================================
# Usar solo para una prueba manual con facturación de API habilitada.
OPENAI_API_KEY=REPLACE_ME
INCUBIA_MODEL=gpt-4o-mini
# Opcionales:
# INCUBIA_ENV_FILE=.env
# INCUBIA_LOG_FILE=logs/incubia-cli.log
# INCUBIA_BUDGET_FILE=~/.local/state/incubia/api-budget.json

# =====================================================================
# 2. Canal Telegram
# =====================================================================
TELEGRAM_BOT_TOKEN=8830027439:AAEFgvH3c7meEM9Q1X2Y7MV6W6877DXcOHo
# INCUBIA_TELEGRAM_DB=~/.local/state/incubia/telegram.sqlite3
# INCUBIA_TELEGRAM_DEPLOYMENT_ID=incubia-telegram
# INCUBIA_TELEGRAM_TENANT_ID=telegram-users

# =====================================================================
# 3. E3 — Ledger en Neon (rama sintética; ver deploy/e3-neon.env.example)
# =====================================================================
INCUBIA_E3_NEON_BRANCH=e3-h1-synthetic
DATABASE_URL=postgresql://incubia_runtime:REPLACE_ME@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
INCUBIA_MIGRATION_DATABASE_URL=postgresql://incubia_migrator:REPLACE_ME@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
INCUBIA_E3_DB_POOL_MAX=4
# Tests y campañas Neon opt-in (1 = activar).
INCUBIA_E3_NEON_TESTS=0
INCUBIA_E3_H4_NEON_TESTS=0
INCUBIA_E3_H1_BACKUP_EVIDENCE=

# =====================================================================
# 4. E3 — Probe HTTP real (ver deploy/e3-probe.env.example)
# =====================================================================
INCUBIA_E3_PROBE_REAL=0
INCUBIA_E3_PROBE_BRANCH=e3-h1-synthetic
INCUBIA_E3_PROBE_DEPLOYMENT_ID=synthetic-alpha
INCUBIA_E3_PROBE_TENANT_ID=synthetic-tenant
INCUBIA_E3_PROBE_ACTOR_ID=synthetic-actor
INCUBIA_E3_PROBE_TOKEN=RANDOM_INCUBIA_KNOWLEDGE_RUNTIME_SECRET_FOR_DEVELOPMENT
# Knowledge sintético del probe (NO es el RAG IncubiaLab, ver sección 7).
# Rol incubia_knowledge_runtime: SELECT sobre knowledge_generations/sources/chunks.
# Se crea con scripts/e3/provision_knowledge_runtime.py tras las migraciones, usando:
# INCUBIA_E3_KNOWLEDGE_ADMIN_DSN=postgresql://neondb_owner:REPLACE_ME@ep-example.us-east-2.aws.neon.tech/knowledge_alpha?sslmode=require
# INCUBIA_E3_KNOWLEDGE_RUNTIME_PASSWORD=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET
INCUBIA_E3_PROBE_KNOWLEDGE_DSN=postgresql://incubia_knowledge_runtime:REPLACE_ME@ep-example-pooler.us-east-2.aws.neon.tech/knowledge_alpha?sslmode=require
INCUBIA_E3_PROBE_BUDGET_FILE=/tmp/incubia-e3-probe-budget.sqlite
INCUBIA_E3_PROBE_MAX_CALLS=20
INCUBIA_E3_PROBE_MAX_INPUT_TOKENS=2000
INCUBIA_E3_PROBE_USD_CAP=0.01
# Audit: archivo SQLite por defecto; con DSN usa Postgres durable (solo rol incubia_runtime).
INCUBIA_E3_PROBE_AUDIT_FILE=/tmp/incubia-e3-probe-audit.sqlite
# INCUBIA_E3_PROBE_AUDIT_DSN=postgresql://incubia_runtime:REPLACE_ME@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# =====================================================================
# 5. E3 — Campañas con gasto (1 solo con presupuesto aprobado)
# =====================================================================
INCUBIA_E3_READ_REAL=0
# INCUBIA_E3_READ_PRODUCT_REF=3017620422003
INCUBIA_E3_H4_APPROVED_BUDGET=0
# hash | local | openai
INCUBIA_E3_H4_EMBEDDING=hash

# =====================================================================
# 6. E3-D0 local (opcionales; defaults en bootstrap/d0.py)
# =====================================================================
# INCUBIA_D0_MODE=local
# INCUBIA_D0_PORT=8080
# INCUBIA_D0_DEPLOYMENT_ID=
# INCUBIA_D0_TENANT_ID=
# INCUBIA_D0_ACTOR_ID=
# INCUBIA_D0_ACCOUNT=d0-http
# INCUBIA_D0_HISTORY_LIMIT=20
# INCUBIA_D0_AUDIT=postgres

# =====================================================================
# 7. RAG IncubiaLab — Neon Knowledge aislado
#    Ver docs/roadmap/etapa-3/NEON-KNOWLEDGE-DEV.md. Valores reales en deploy/knowledge-neon.env (0600).
#    Rama dedicada obligatoria: production/main/master son rechazadas por scripts/e3/neon_branch_guard.py.
# =====================================================================
# Identidad del entorno (comparar con el endpoint antes de migrar).
INCUBIA_KNOWLEDGE_NEON_PROJECT_ID=REPLACE_ME
INCUBIA_KNOWLEDGE_NEON_BRANCH=feat-knowledge-base
INCUBIA_KNOWLEDGE_NEON_BRANCH_ID=br-REPLACE_ME
INCUBIA_KNOWLEDGE_DATABASE=incubialab_knowledge_dev
# Deployment confiable al que se vincula el runtime (bootstrap/knowledge_incubialab.py; obligatorio).
INCUBIA_KNOWLEDGE_DEPLOYMENT_ID=incubialab

# Runtime: pooled TLS, rol incubia_kb_runtime, solo SELECT.
# Consumido por modules/knowledge/adapters/runtime_dsn.py (falla cerrado si no cumple).
INCUBIA_KNOWLEDGE_RUNTIME_DATABASE_URL=postgresql://incubia_kb_runtime:REPLACE_ME@ep-example-pooler.us-east-2.aws.neon.tech/incubialab_knowledge_dev?sslmode=require
# Migrador: directa, rol incubia_kb_migrator, DDL en public (runner de migraciones Knowledge pendiente).
INCUBIA_KNOWLEDGE_MIGRATION_DATABASE_URL=postgresql://incubia_kb_migrator:REPLACE_ME@ep-example.us-east-2.aws.neon.tech/incubialab_knowledge_dev?sslmode=require
# Ingestor: pooled, rol incubia_kb_ingestor, DML sobre tablas Knowledge (consumidor previsto en RAG-V2).
INCUBIA_KNOWLEDGE_INGEST_DATABASE_URL=postgresql://incubia_kb_ingestor:REPLACE_ME@ep-example-pooler.us-east-2.aws.neon.tech/incubialab_knowledge_dev?sslmode=require

# Corpus Drive (service account con lector sobre la carpeta; scope drive.readonly).
# Clave JSON fuera del repo, permisos 0600. Uso: scripts/e3/ingest_drive_knowledge.py
INCUBIA_DRIVE_SERVICE_ACCOUNT_FILE=~/.config/incubia/drive-sa.json
INCUBIA_DRIVE_ROOT_FOLDER_ID=1IiwcAQpeY-OeK9EwkS9oJnfMxw653kun
# Embedding OpenAI text-embedding-3-small (384). Presupuesto aprobado: USD 1 / 500 calls.
# INCUBIA_KNOWLEDGE_EMBEDDING_BUDGET_FILE=~/.local/state/incubia/knowledge-embedding-budget.sqlite
