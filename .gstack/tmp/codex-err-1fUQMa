from collections.abc import Callable, Mapping
from dataclasses import dataclass
from datetime import UTC, datetime, timedelta
from typing import Any
from uuid import uuid4

from incubia_orchestrator.foundation.contracts.execution import ExecutionScope
from incubia_orchestrator.modules.audit.domain.audit import AuditEvent, AuditEventType
from incubia_orchestrator.modules.audit.ports.sink import AuditSinkPort
from incubia_orchestrator.modules.orchestration.application.grounded_response import GroundedResponse, GroundedAnswer
from incubia_orchestrator.modules.orchestration.application.tool_selection import NoEligibleTool, select_tool
from incubia_orchestrator.modules.orchestration.domain.tools import ToolInvocation
from incubia_orchestrator.modules.orchestration.ports.tool_discovery import ToolDiscoveryPort


@dataclass(frozen=True)
class ReadRequest:
    input_data: Mapping[str, Any]
    resource: str


class GroundedWorkflow:
    """The caller supplies trusted scope and a controlled READ input builder."""

    def __init__(self, grounded: GroundedResponse, discovery: ToolDiscoveryPort,
                 execute_tool: Callable[[ToolInvocation], Any],
                 read_request: Callable[[str, str, ExecutionScope], ReadRequest | None],
                 *, deadline_seconds: float = 10, audit: AuditSinkPort | None = None):
        if deadline_seconds <= 0:
            raise ValueError("deadline_seconds must be positive")
        self._grounded = grounded
        self._discovery = discovery
        self._execute_tool = execute_tool
        self._read_request = read_request
        self._deadline_seconds = deadline_seconds
        self._audit = audit

    def answer(self, scope: ExecutionScope, query: str, capability: str,
               *, execution_id: str | None = None) -> GroundedAnswer:
        execution_id = execution_id or str(uuid4())
        deadline = datetime.now(UTC) + timedelta(seconds=self._deadline_seconds)
        tool_evidence = ()
        request = self._read_request(query, capability, scope)
        if request is not None:
            try:
                descriptor = select_tool(self._discovery.find(
                    capability, scope, input_data=request.input_data
                ))
            except NoEligibleTool:
                descriptor = None
            if descriptor is not None and datetime.now(UTC) < deadline:
                invocation = ToolInvocation(
                    str(uuid4()), execution_id, scope, descriptor.tool_id,
                    request.input_data, request.resource,
                    deadline_seconds=max(0.001, (deadline - datetime.now(UTC)).total_seconds()),
                    input_schema_version=descriptor.input_schema_version,
                    tool_version=descriptor.tool_version,
                )
                # ExecuteTool is the PEP. Audit failures propagate before adapter I/O.
                tool_evidence = GroundedResponse.read_evidence(self._execute_tool, invocation)
        try:
            answer = self._grounded.answer(scope, query, capability,
                                           deadline=deadline, tool_evidence=tool_evidence)
        except Exception as exc:
            self._emit(AuditEventType.OUTCOME, "workflow.outcome", scope, execution_id,
                       status="failed", error_code=type(exc).__name__[:64])
            raise
        # Retrieval runs inside GroundedResponse (knowledge code is not edited);
        # it is audited here from the orchestration side, correlated by execution_id.
        self._emit(AuditEventType.RETRIEVAL, "knowledge.retrieval", scope, execution_id,
                   status="abstained" if answer.abstained else "answered",
                   metadata={"evidence_count": len(answer.evidence), "abstained": answer.abstained})
        self._emit(AuditEventType.OUTCOME, "workflow.outcome", scope, execution_id,
                   status="abstained" if answer.abstained else "completed",
                   metadata={"evidence_count": len(answer.evidence), "abstained": answer.abstained})
        return answer

    def _emit(self, event_type: AuditEventType, tool_id: str, scope: ExecutionScope,
              execution_id: str, *, status: str, error_code: str | None = None,
              metadata: dict | None = None) -> None:
        if self._audit is None:
            return
        self._audit.append(AuditEvent.now(
            event_id=str(uuid4()), event_type=event_type,
            tool_call_id=f"{execution_id}:{event_type.value}", execution_id=execution_id,
            scope=scope, tool_id=tool_id, status=status, error_code=error_code,
            metadata=metadata or {},
        ))
"""Bounded evidence composition before a response is exposed to a channel."""
from dataclasses import dataclass
from datetime import datetime, timezone
import re

from incubia_orchestrator.modules.knowledge.domain import EvidenceItem, RetrievalQuery
from incubia_orchestrator.modules.knowledge.ports import RetrievalPort
from incubia_orchestrator.foundation.contracts.execution import ExecutionScope
from incubia_orchestrator.foundation.public_references import safe_public_ref
from incubia_orchestrator.modules.orchestration.domain.tools import ToolInvocation, ToolStatus


@dataclass(frozen=True)
class GroundedAnswer:
    text: str
    evidence: tuple[EvidenceItem, ...]
    public_references: tuple[str, ...]
    abstained: bool


class GroundedResponse:
    """Only supplied, scoped evidence can support a factual response."""

    def __init__(self, retrieval: RetrievalPort, *, min_score: float = 0.2):
        self._retrieval = retrieval
        self._min_score = min_score

    @staticmethod
    def read_evidence(execute_tool, invocation: ToolInvocation) -> tuple[EvidenceItem, ...]:
        """Execute via the governed PEP and bound untrusted READ output."""
        result = execute_tool(invocation)
        if result.status is not ToolStatus.SUCCESS or not result.output:
            return ()
        if result.output.get("untrusted_content") is True:
            return ()
        raw = result.output.get("items")
        if not isinstance(raw, list):
            return ()
        evidence = []
        for index, entry in enumerate(raw[:5]):
            if not isinstance(entry, dict):
                continue
            description = entry.get("description") or entry.get("name") or entry.get("product_name")
            if not isinstance(description, str) or not description.strip():
                continue
            # Tool metadata is provenance, not a claim that the text is trusted.
            evidence.append(EvidenceItem(invocation.scope.deployment_id,
                                         result.source or result.tool_id,
                                         invocation.tool_version or "1",
                                         f"{invocation.tool_call_id}:{index}",
                                         invocation.tool_call_id, description[:1024],
                                         public_ref=safe_public_ref(result.external_reference or
                                                                    result.output.get("source_url"))))
        return tuple(evidence)

    def answer(self, scope: ExecutionScope, query: str, capability: str, *,
               deadline: datetime | None = None, tool_evidence: tuple[EvidenceItem, ...] = (),
               execution_id: str | None = None) -> GroundedAnswer:
        del execution_id  # Correlation is used by a coordinator when a Tool READ is present.
        if deadline is not None and datetime.now(timezone.utc) >= deadline:
            return GroundedAnswer("No tengo evidencia suficiente para responder.", (), (), True)
        retrieved = self._retrieval.retrieve(RetrievalQuery(scope, query, capability, deadline=deadline))
        candidates = tuple(item for item in (*retrieved, *tool_evidence)
                           if item.deployment_id == scope.deployment_id
                           and (item.score is None or item.score >= self._min_score))
        if not candidates:
            return GroundedAnswer("No tengo evidencia suficiente para responder.", (), (), True)
        versions = {}
        for item in candidates:
            previous = versions.setdefault(item.source_id, (item.source_version, item.text))
            if previous != (item.source_version, item.text):
                return GroundedAnswer("Las fuentes disponibles se contradicen; necesito verificar antes de responder.",
                                      (), (), True)
        if any(re.search(r"ignore\s+(?:all\s+)?previous|system\s+message|<\|(?:system|assistant)|"
                         r"ignora\s+(?:todas\s+)?(?:las\s+)?instrucciones|revela\s+(?:el\s+)?secreto",
                         item.text, re.I) for item in candidates):
            return GroundedAnswer("No tengo evidencia segura para responder.", (), (), True)
        # Extract the best Knowledge hit and reserve room for a governed READ.
        eligible = tuple(item for item in candidates if item in retrieved)[:1] + tuple(
            item for item in tool_evidence if item in candidates)[:4]
        # This is a deterministic extractive baseline. A generative adapter must
        # separately verify claims before it can replace this behavior.
        text = "\n".join(item.text for item in eligible)
        references = tuple(dict.fromkeys(ref for item in eligible
                                         if (ref := safe_public_ref(item.public_ref))))
        return GroundedAnswer(text, eligible, references, False)
"""OpenAI Responses HTTP adapter. Client injection keeps tests offline."""
import httpx
from incubia_orchestrator.modules.orchestration.adapters.llm.monthly_limit import MonthlyCallLimiter
from incubia_orchestrator.foundation.contracts.execution import TokenUsage
from incubia_orchestrator.modules.orchestration.ports.llm import GenerationFailure, GenerationRequest, GenerationResponse


class OpenAILLM:
    def __init__(self, *, model: str, api_key: str, timeout: float = 30,
                 retries: int = 0, client: httpx.Client | None = None,
                 limiter: MonthlyCallLimiter | None = None, metrics=None):
        if not model:
            raise ValueError("Define INCUBIA_MODEL/--model")
        if not api_key:
            raise ValueError("Define OPENAI_API_KEY; usa --fake sin credenciales")
        if timeout <= 0 or retries < 0:
            raise ValueError("Invalid transport limits")
        self.model, self.api_key, self.timeout, self.retries = model, api_key, timeout, retries
        self.client = client or httpx.Client(timeout=timeout)
        self.limiter = limiter
        self.metrics = metrics

    def generate(self, request: GenerationRequest) -> GenerationResponse:
        try:
            response = self._generate(request)
        except GenerationFailure as exc:
            self._record_failure(exc.code)
            raise
        if self.metrics is not None and response.usage is not None:
            try:
                self.metrics.cost("llm", input_tokens=response.usage.input_tokens,
                                  output_tokens=response.usage.output_tokens)
            except Exception:
                pass
        return response

    def _record_failure(self, code: str) -> None:
        if self.metrics is None:
            return
        category = {"PROVIDER_QUOTA": "provider_quota", "PROVIDER_RATE_LIMIT": "provider_limit",
                    "LOCAL_MONTHLY_LIMIT": "budget", "LOCAL_COOLDOWN": "budget"}.get(code)
        if category:
            try:
                self.metrics.rejection(category, code)
            except Exception:
                pass

    def _generate(self, request: GenerationRequest) -> GenerationResponse:
        if self.limiter is not None:
            self.limiter.reserve()
        messages = []
        for turn in request.history:
            messages.extend(({"role": "user", "content": turn.user},
                             {"role": "assistant", "content": turn.assistant}))
        messages.append({"role": "user", "content": request.text})
        body = {"model": request.model or self.model, "instructions": request.instructions, "input": messages,
                "max_output_tokens": request.max_output_tokens, "store": False}
        for attempt in range(self.retries + 1):
            try:
                response = self.client.post("https://api.openai.com/v1/responses", json=body,
                                            headers={"Authorization": f"Bearer {self.api_key}"},
                                            timeout=self.timeout)
            except httpx.TimeoutException:
                if attempt < self.retries:
                    continue
                raise GenerationFailure("PROVIDER_TIMEOUT") from None
            except httpx.TransportError:
                if attempt < self.retries:
                    continue
                raise GenerationFailure("PROVIDER_UNAVAILABLE") from None
            if response.status_code in (429, 500, 502, 503, 504) and attempt < self.retries:
                continue
            if response.status_code == 401:
                raise GenerationFailure("PROVIDER_AUTH")
            if response.status_code == 429:
                try:
                    error = response.json().get("error") or {}
                    if error.get("type") == "insufficient_quota" or error.get("code") == "credit_balance_exhausted":
                        raise GenerationFailure("PROVIDER_QUOTA")
                except (ValueError, AttributeError):
                    pass
                raise GenerationFailure("PROVIDER_RATE_LIMIT")
            if response.status_code >= 400:
                raise GenerationFailure("PROVIDER_ERROR")
            try:
                data = response.json()
                if data.get("status") != "completed":
                    raise GenerationFailure("PROVIDER_INCOMPLETE")
                text = "".join(part["text"] for item in data["output"]
                               if item.get("type") == "message"
                               for part in item.get("content", []) if part.get("type") == "output_text")
                if not text.strip():
                    raise GenerationFailure("EMPTY_RESPONSE")
                raw_usage = data.get("usage")
                usage = None
                if isinstance(raw_usage, dict) and isinstance(raw_usage.get("input_tokens"), int) and isinstance(raw_usage.get("output_tokens"), int):
                    usage = TokenUsage(raw_usage["input_tokens"], raw_usage["output_tokens"])
                return GenerationResponse(text, usage)
            except (ValueError, KeyError, TypeError, AttributeError):
                raise GenerationFailure("PROVIDER_INVALID_RESPONSE") from None
        raise AssertionError("Unreachable")

